Meta.DisplayName=Haben - Software
Meta.Description=Haben - selbst gehostete Buchhaltung: Rechnungen (ZUGFeRD/XRechnung), Belege, Bankabgleich, EÜR/Bilanz und ELSTER
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=amp-haben
Meta.URL=https://haben.app/
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/firsttris/haben/main/apps/web/public/icon-512.png
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$HttpPort}
Meta.ConfigManifest=habenconfig.json
Meta.MetaConfigManifest=habenmetaconfig.json
Meta.ConfigRoot=haben.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Haben braucht PostgreSQL, Poppler (PDF-Auslesung) und Schriften, die nur im Container zuverlässig bereitstehen.
Meta.ExtraSetupStepsURI=https://github.com/Vladislavvk1337/amp-template-haben#readme
Meta.ResourceUsageInfo=1 CPU-Kern und 1 GB RAM im Betrieb; für den Build beim Update 2 Kerne und 4 GB RAM empfohlen
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["postgresql","poppler-utils","fonts-liberation","git","unzip","curl","ca-certificates","tzdata","libgcc-s1","restic","openssh-client","util-linux","gzip"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Haben aus den Quellen gebaut, eingebettete PostgreSQL. Sicherung: AMP-Backups (Lokal/S3) mit konsistentem Dump und automatischer Wiederherstellung, dazu restic nach lokal, S3, SFTP oder REST mit Aufbewahrung und Test-Restore.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=2c0c4a8c-ffe1-46be-a819-1993370a8c30
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Haben - Software
App.RootDir=./haben/
App.BaseDirectory=./haben/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs="{{$FullBaseDir}}scripts/haben.sh" run
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"HABEN_ROOT":"{{$FullBaseDir}}","HABEN_DB_MODE":"{{DatabaseMode}}","HABEN_DB_PORT":"{{DatabasePort}}","HABEN_EXTERNAL_DATABASE_URL":"{{ExternalDatabaseUrl}}","HABEN_DUMP_INTERVAL":"{{DumpInterval}}","HABEN_BACKUP_TARGET":"{{BackupTarget}}","HABEN_BACKUP_LOCAL_PATH":"{{BackupLocalPath}}","HABEN_BACKUP_S3_ENDPOINT":"{{BackupS3Endpoint}}","HABEN_BACKUP_S3_BUCKET":"{{BackupS3Bucket}}","HABEN_BACKUP_S3_PREFIX":"{{BackupS3Prefix}}","HABEN_BACKUP_S3_REGION":"{{BackupS3Region}}","HABEN_BACKUP_S3_ACCESS_KEY":"{{BackupS3AccessKey}}","HABEN_BACKUP_S3_SECRET_KEY":"{{BackupS3SecretKey}}","HABEN_BACKUP_REPOSITORY":"{{BackupRepository}}","HABEN_BACKUP_PASSWORD":"{{BackupPassword}}","HABEN_BACKUP_TIME":"{{BackupTime}}","HABEN_BACKUP_HOST":"{{BackupHostName}}","HABEN_BACKUP_KEEP_DAILY":"{{BackupKeepDaily}}","HABEN_BACKUP_KEEP_WEEKLY":"{{BackupKeepWeekly}}","HABEN_BACKUP_KEEP_MONTHLY":"{{BackupKeepMonthly}}","HABEN_BACKUP_KEEP_YEARLY":"{{BackupKeepYearly}}","HABEN_RESTORE_CHECK_DAYS":"{{RestoreCheckDays}}","HABEN_OVERRIDE_AUTH_SECRET":"{{AuthSecretOverride}}","HABEN_OVERRIDE_ENCRYPTION_KEY":"{{EncryptionKeyOverride}}","HOST":"{{$ApplicationIPBinding}}","PORT":"{{$HttpPort}}","BETTER_AUTH_URL":"{{PublicUrl}}","TZ":"{{TimeZone}}","ERIC_AUTO_INSTALL":"{{EricAutoInstall}}","ERIC_SHA256":"{{EricSha256}}","ELSTER_HERSTELLER_ID":"{{ElsterHerstellerId}}","ANTHROPIC_API_KEY":"{{AnthropicApiKey}}","EXTRACTION_BASE_URL":"{{ExtractionBaseUrl}}","EXTRACTION_MODEL":"{{ExtractionModel}}","EXTRACTION_API_KEY":"{{ExtractionApiKey}}","ENABLE_BANKING_APP_ID":"{{EnableBankingAppId}}","OIDC_ONLY":"{{OidcOnly}}","OIDC_ISSUER":"{{OidcIssuer}}","OIDC_CLIENT_ID":"{{OidcClientId}}","OIDC_CLIENT_SECRET":"{{OidcClientSecret}}","OIDC_SCOPES":"{{OidcScopes}}","OIDC_DISPLAY_NAME":"{{OidcDisplayName}}","OIDC_GROUPS_CLAIM":"{{OidcGroupsClaim}}","OIDC_GROUP_INHABER":"{{OidcGroupInhaber}}","OIDC_GROUP_STEUERBERATUNG":"{{OidcGroupSteuerberatung}}"}
